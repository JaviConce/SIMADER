        "wires": []
    },
    {
        "id": "mqtt_in_emg",
        "type": "mqtt in",
        "z": "flow_uibuilder",
        "name": "EMG Data",
        "topic": "esp32/emg_data",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt_broker_main",
        "inputs": 0,
        "x": 160,
        "y": 300,
        "wires": [
            [
                "process_emg"
            ]
        ]
    },
    {
        "id": "process_emg",
        "type": "function",
        "z": "flow_uibuilder",
        "name": "Process EMG",
        "func": "const activeSession = flow.get('activeSession');\nif (!activeSession) return null;\n\nconst data = msg.payload;\nif (!data || data.emg === undefined) return null;\n\n// Guardar en array temporal\nlet emgData = flow.get('emgData') || [];\nemgData.push({ emg: data.emg, raw: data.raw || null, voltaje: data.voltaje || null });\nflow.set('emgData', emgData);\n\n// Enviar a UI\nmsg.topic = 'emg_data';\nmsg.payload = data.emg;\n\nreturn msg;",
        "outputs": 1,
        "x": 370,
        "y": 300,
        "wires": [
            [
                "uib_simader"
            ]
        ]
    },
    {
        "id": "mqtt_in_clients",
        "type": "mqtt in",
        "z": "flow_uibuilder",
        "name": "ESP32 Clients",
        "topic": "esp32/clients",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt_broker_main",
        "inputs": 0,
        "x": 160,
        "y": 420,
        "wires": [
            [
                "format_clients"
            ]
        ]
    },
    {
        "id": "format_clients",
        "type": "function",
        "z": "flow_uibuilder",
        "name": "Format Clients",
        "func": "// Formatear clientes del ESP32 para el frontend\nif (!msg.payload || !msg.payload.clients) {\n    return null;\n}\n\nmsg.topic = 'sensores';\nreturn msg;",
        "outputs": 1,
        "x": 360,
        "y": 420,
        "wires": [
            [
                "uib_simader"
            ]
        ]
    },
    {
        "id": "mqtt_in_responses",
        "type": "mqtt in",
