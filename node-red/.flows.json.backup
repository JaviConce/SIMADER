    {
        "id": "api_get_sesiones",
        "type": "http in",
        "z": "flow_api",
        "name": "GET /api/sesiones",
        "url": "/api/sesiones",
        "method": "get",
        "upload": false,
        "swaggerDoc": "",
        "x": 160,
        "y": 160,
        "wires": [
            [
                "query_api_sesiones"
            ]
        ]
    },
    {
        "id": "query_api_sesiones",
        "type": "sqlite",
        "z": "flow_api",
        "mydb": "sqlite_db",
        "sqlquery": "fixed",
        "sql": "SELECT s.id, s.nombre, s.fecha_inicio, s.fecha_fin, s.estado, p.nombre as persona_nombre, p.id as persona_id, e.total_muestras, e.emg_promedio, e.emg_max, e.emg_min, e.duracion_segundos FROM sesiones s LEFT JOIN personas p ON s.persona_id = p.id LEFT JOIN estadisticas_sesion e ON s.id = e.sesion_id WHERE s.estado = 'finalizada' ORDER BY s.fecha_inicio DESC",
        "name": "Query Sesiones",
        "x": 380,
        "y": 160,
        "wires": [
            [
                "response_sesiones"
            ]
        ]
    },
    {
        "id": "response_sesiones",
        "type": "http response",
        "z": "flow_api",
        "name": "Response",
        "statusCode": "200",
        "headers": {
            "Content-Type": "application/json",
            "Access-Control-Allow-Origin": "*"
        },
        "x": 570,
        "y": 160,
        "wires": []
    },
    {
        "id": "api_get_sesion_datos",
        "type": "http in",
        "z": "flow_api",
        "name": "GET /api/sesion/:id/datos",
        "url": "/api/sesion/:id/datos",
        "method": "get",
        "upload": false,
        "swaggerDoc": "",
        "x": 180,
        "y": 240,
        "wires": [
            [
                "prepare_query_datos"
            ]
        ]
    },
    {
        "id": "prepare_query_datos",
        "type": "function",
        "z": "flow_api",
        "name": "Prepare Query",
        "func": "const id = parseInt(msg.req.params.id);\nif (isNaN(id)) {\n    msg.payload = { error: 'Invalid session ID' };\n    return [null, msg];\n}\nmsg.params = [id];\nreturn msg;",
        "outputs": 1,
        "x": 400,
        "y": 240,
        "wires": [
            [
                "query_api_datos"
            ]
        ]
    },
    {
        "id": "query_api_datos",
        "type": "sqlite",
        "z": "flow_api",
        "mydb": "sqlite_db",
        "sqlquery": "prepared",
        "sql": "SELECT valor_emg, valor_crudo, voltaje, timestamp_servidor FROM datos_emg WHERE sesion_id = ? ORDER BY id",
        "name": "Query Datos EMG",
        "x": 600,
        "y": 240,
        "wires": [
            [
                "format_datos"
            ]
        ]
    },
    {
        "id": "format_datos",
        "type": "function",
        "z": "flow_api",
        "name": "Format Response",
        "func": "// Extraer solo los valores EMG para el gráfico\nconst emgValues = msg.payload.map(d => d.valor_emg);\nconst fullData = msg.payload;\n\nmsg.payload = {\n    sesion_id: msg.req.params.id,\n    total: fullData.length,\n    emg_values: emgValues,\n    datos: fullData\n};\nreturn msg;",
        "outputs": 1,
        "x": 790,
        "y": 240,
        "wires": [
            [
                "response_datos"
            ]
        ]
    },
    {
        "id": "response_datos",
        "type": "http response",
        "z": "flow_api",
        "name": "Response",
        "statusCode": "200",
        "headers": {
            "Content-Type": "application/json",
            "Access-Control-Allow-Origin": "*"
        },
        "x": 970,
        "y": 240,
        "wires": []
    },
