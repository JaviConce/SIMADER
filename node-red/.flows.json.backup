    {
        "id": "query_api_stats",
        "type": "sqlite",
        "z": "flow_api",
        "mydb": "sqlite_db",
        "sqlquery": "fixed",
        "sql": "SELECT p.nombre as persona, COUNT(s.id) as total_sesiones, SUM(e.total_muestras) as total_muestras, AVG(e.emg_promedio) as emg_promedio_global, MAX(e.emg_max) as emg_max_global, MIN(e.emg_min) as emg_min_global FROM personas p LEFT JOIN sesiones s ON p.id = s.persona_id AND s.estado = 'finalizada' LEFT JOIN estadisticas_sesion e ON s.id = e.sesion_id GROUP BY p.id ORDER BY total_sesiones DESC",
        "name": "Query Stats",
        "x": 390,
        "y": 320,
        "wires": [
            [
                "response_stats"
            ]
        ]
    },
    {
        "id": "response_stats",
        "type": "http response",
        "z": "flow_api",
        "name": "Response",
        "statusCode": "200",
        "headers": {
            "Content-Type": "application/json",
            "Access-Control-Allow-Origin": "*"
        },
        "x": 570,
        "y": 320,
        "wires": []
    },
    {
        "id": "comment_api",
        "type": "comment",
        "z": "flow_api",
        "name": "📡 API REST - Endpoints disponibles",
        "info": "## Endpoints:\n\n- GET /api/personas - Lista de personas\n- GET /api/sesiones - Sesiones con estadísticas\n- GET /api/sesion/:id/datos - Datos EMG de una sesión\n- GET /api/estadisticas - Resumen por persona\n\n## Ejemplo:\nhttp://localhost:1880/api/personas",
        "x": 210,
        "y": 580,
        "wires": []
    }
