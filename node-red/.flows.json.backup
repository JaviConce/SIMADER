    {
        "id": "uib_handler",
        "type": "function",
        "z": "flow_uibuilder",
        "name": "Handle UI Messages",
        "func": "const topic = msg.topic;\nconst payload = msg.payload;\n\nswitch (topic) {\n    case 'session/start':\n        flow.set('activeSession', payload);\n        flow.set('emgData', []);\n        node.status({fill:'green', shape:'dot', text:'Sesión activa'});\n        // Enviar comando al ESP32\n        return [null, {topic: 'esp32/commands', payload: payload}, null];\n        \n    case 'session/stop':\n        flow.set('activeSession', null);\n        node.status({fill:'red', shape:'ring', text:'Sesión detenida'});\n        \n        // Guardar datos completos de la sesión\n        flow.set('lastSessionData', payload);\n        \n        // Validar que persona_id existe\n        if (!payload.persona_id) {\n            node.error('❌ ERROR: persona_id es null o undefined');\n            node.error('Payload completo: ' + JSON.stringify(payload));\n            return [null, null, null];\n        }\n        \n        // Preparar parámetros para insertar sesión (array para SQLite)\n        msg.params = [\n            parseInt(payload.persona_id),\n            payload.nombre || (payload.persona_nombre + ' - ' + new Date().toLocaleDateString()),\n            payload.fecha_inicio,\n            payload.fecha_fin,\n            'finalizada'\n        ];\n        \n        return [msg, null, null];\n        \n    case 'persona/new':\n        msg.params = [payload.nombre, payload.email || null, payload.telefono || null,  payload.descripcion || null];\n        return [msg, null, null];\n        \n    case 'persona/delete':\n        msg.params = [payload.id];\n        return [msg, null, null];\n        \n    case 'sensores/request':\n        // Devolver lista de sensores conectados\n        let sensores = global.get('sensores_conectados') || [];\n        if (sensores.length === 0) {\n            sensores = [\n                { id: 'ESP32_001', ip: '192.168.4.100', nombre: 'Sensor EMG 1', estado: 'desconocido' },\n                { id: 'ESP32_002', ip: '192.168.4.101', nombre: 'Sensor EMG 2', estado: 'desconocido' }\n            ];\n        }\n        return [null, null, { topic: 'sensores', payload: sensores, _uib: msg._uib }];\n        \n    case 'esp32/commands':\n        // Reenviar comando MQTT al broker\n        return [null, { topic: 'esp32/commands', payload: payload }, null];\n        \n    default:\n        return [null, null, null];\n}\n",
        "outputs": 3,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 200,
        "wires": [
            [
                "save_to_db"
            ],
            [
                "mqtt_out_commands"
            ],
            [
                "uib_simader"
            ]
        ]
    },
    {
        "id": "inject_load_data",
        "type": "inject",
        "z": "flow_uibuilder",
        "name": "Load on Start",
        "props": [
            {
                "p": "topic",
                "vt": "str"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": true,
        "onceDelay": "2",
        "topic": "init",
        "x": 160,
        "y": 100,
        "wires": [
            [
                "load_personas",
                "load_sesiones"
            ]
        ]
    },
    {
        "id": "load_personas",
        "type": "sqlite",
        "z": "flow_uibuilder",
        "mydb": "sqlite_db",
        "sqlquery": "fixed",
        "sql": "SELECT id, nombre, email, telefono FROM personas ORDER BY nombre",
        "name": "Get Personas",
        "x": 370,
        "y": 60,
        "wires": [
            [
                "format_personas"
            ]
        ]
    },
    {
        "id": "format_personas",
        "type": "function",
        "z": "flow_uibuilder",
        "name": "Format for UI",
        "func": "msg.topic = 'personas';\nreturn msg;",
        "outputs": 1,
        "x": 560,
        "y": 60,
        "wires": [
            [
                "uib_simader"
            ]
        ]
    },
    {
        "id": "load_sesiones",
        "type": "sqlite",
        "z": "flow_uibuilder",
        "mydb": "sqlite_db",
        "sqlquery": "fixed",
        "sql": "SELECT s.*, e.total_muestras, e.emg_promedio, e.emg_max, e.emg_min FROM sesiones s LEFT JOIN estadisticas_sesion e ON s.id = e.sesion_id WHERE s.estado = 'finalizada' ORDER BY s.fecha_inicio DESC LIMIT 50",
        "name": "Get Sesiones",
        "x": 350,
        "y": 120,
        "wires": [
            [
                "format_sesiones"
            ]
        ]
    },
    {
        "id": "format_sesiones",
        "type": "function",
        "z": "flow_uibuilder",
        "name": "Format for UI",
        "func": "msg.topic = 'sesiones';\nmsg.payload = msg.payload.map(s => ({\n    ...s,\n    persona_nombre: s.nombre || 'Sesión ' + s.id\n}));\nreturn msg;",
        "outputs": 1,
        "x": 560,
        "y": 140,
        "wires": [
            [
                "uib_simader"
            ]
        ]
    },
    {
        "id": "save_to_db",
        "type": "switch",
        "z": "flow_uibuilder",
        "name": "Route by Topic",
        "property": "topic",
        "propertyType": "msg",
        "rules": [
            {
                "t": "eq",
                "v": "session/stop",
                "vt": "str"
            },
            {
                "t": "eq",
                "v": "persona/new",
                "vt": "str"
            },
            {
                "t": "eq",
                "v": "persona/delete",
                "vt": "str"
            }
        ],
        "checkall": "false",
        "repair": false,
        "outputs": 3,
        "x": 820,
        "y": 200,
        "wires": [
            [
                "save_session"
            ],
            [
                "save_persona"
            ],
            [
                "delete_persona"
            ]
        ]
    },
    {
        "id": "debug_before_save",
        "type": "debug",
        "z": "flow_uibuilder",
        "name": "Debug params",
        "active": false,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "params",
        "targetType": "msg",
        "x": 850,
        "y": 140,
        "wires": []
    },
    {
        "id": "save_session",
        "type": "sqlite",
        "z": "flow_uibuilder",
        "mydb": "sqlite_db",
        "sqlquery": "prepared",
        "sql": "INSERT INTO sesiones (persona_id, nombre, fecha_inicio, fecha_fin, estado) VALUES (?, ?, ?, ?, ?)",
        "name": "Save Session",
        "x": 1020,
        "y": 180,
        "wires": [
            [
                "delay_before_id"
            ]
        ]
    },
    {
        "id": "delay_before_id",
        "type": "delay",
        "z": "flow_uibuilder",
        "name": "Wait 100ms",
        "pauseType": "delay",
        "timeout": "100",
        "timeoutUnits": "milliseconds",
        "rate": "1",
        "nbRateUnits": "1",
        "rateUnits": "second",
        "randomFirst": "1",
        "randomLast": "5",
        "randomUnits": "seconds",
        "drop": false,
        "allowrate": false,
        "outputs": 1,
        "x": 1140,
        "y": 180,
        "wires": [
            [
                "get_last_insert_id"
            ]
        ]
    },
    {
        "id": "get_last_insert_id",
        "type": "sqlite",
        "z": "flow_uibuilder",
        "mydb": "sqlite_db",
        "sqlquery": "fixed",
        "sql": "SELECT last_insert_rowid() as id",
        "name": "Get Last ID",
        "x": 1320,
        "y": 180,
        "wires": [
            [
                "prepare_stats"
            ]
        ]
    },
    {
        "id": "prepare_stats",
        "type": "function",
        "z": "flow_uibuilder",
        "name": "Prepare Stats",
        "func": "const sessionData = flow.get('lastSessionData');\n\nif (!sessionData) {\n    node.error('No session data found');\n    return null;\n}\n\n// Obtener el ID de la sesión recién insertada\nlet sessionId;\nif (msg.payload && Array.isArray(msg.payload) && msg.payload[0] && msg.payload[0].id) {\n    sessionId = msg.payload[0].id;\n} else {\n    node.error('❌ No se pudo obtener el ID de la sesión insertada');\n    return null;\n}\n\n// Calcular duración en segundos\nconst inicio = new Date(sessionData.fecha_inicio);\nconst fin = new Date(sessionData.fecha_fin);\nconst duracion = Math.floor((fin - inicio) / 1000);\n\nmsg.params = [\n    sessionId,\n    sessionData.total_muestras || 0,\n    sessionData.emg_promedio || 0,\n    sessionData.emg_max || 0,\n    sessionData.emg_min || 0,\n    duracion\n];\n\nmsg.sessionId = sessionId;\n\nreturn msg;",
        "outputs": 1,
        "x": 1460,
        "y": 180,
        "wires": [
            [
                "save_stats"
            ]
        ]
    },
    {
        "id": "save_stats",
        "type": "sqlite",
        "z": "flow_uibuilder",
        "mydb": "sqlite_db",
        "sqlquery": "prepared",
        "sql": "INSERT INTO estadisticas_sesion (sesion_id, total_muestras, emg_promedio, emg_max, emg_min, duracion_segundos) VALUES (?, ?, ?, ?, ?, ?)",
        "name": "Save Stats",
        "x": 1680,
        "y": 180,
        "wires": [
            [
                "prepare_emg_data",
                "delay_before_reload"
            ]
        ]
    },
    {
        "id": "prepare_emg_data",
        "type": "function",
        "z": "flow_uibuilder",
        "name": "Prepare EMG Data",
        "func": "const sessionId = msg.sessionId;\nconst emgData = flow.get('emgData') || [];\n\nif (emgData.length === 0) {\n    node.warn('No EMG data to save');\n    return null;\n}\n\nconst msgs = emgData.map(d => ({\n    params: [sessionId, d.emg, d.raw || null, d.voltaje || null]\n}));\n\nreturn [msgs];",
        "outputs": 1,
        "x": 1680,
        "y": 240,
        "wires": [
            [
                "insert_single_emg"
            ]
        ]
    },
    {
        "id": "insert_single_emg",
