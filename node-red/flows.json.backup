    {
        "id": "persons_widget",
        "type": "ui_template",
        "z": "flow_dashboard",
        "group": "persons_group",
        "name": "Tabla de Personas",
        "order": 1,
        "format": "<div style=\"padding: 10px; font-family: Arial, sans-serif; display: flex; flex-direction: column; height: 100%;\">\n    <h2 style=\"color: #333; margin: 0 0 10px 0;\">📋 Personas Registradas</h2>\n    <p style=\"color: #666; margin: 0 0 15px 0;\">Total: <span style=\"color: #2196F3; font-weight: bold;\" id=\"totalPersonas\">0</span> personas</p>\n    \n    <div style=\"flex: 1; overflow-y: auto; border: 1px solid #ddd; border-radius: 5px; margin-bottom: 15px;\">\n        <table style=\"width: 100%; border-collapse: collapse; font-size: 13px;\">\n            <thead style=\"position: sticky; top: 0;\">\n                <tr style=\"background-color: #2196F3; color: white;\">\n                    <th style=\"padding: 12px; text-align: left; border: 1px solid #ddd; white-space: nowrap;\">ID</th>\n                    <th style=\"padding: 12px; text-align: left; border: 1px solid #ddd; min-width: 150px;\">Nombre</th>\n                    <th style=\"padding: 12px; text-align: left; border: 1px solid #ddd; min-width: 180px;\">Email</th>\n                    <th style=\"padding: 12px; text-align: left; border: 1px solid #ddd; min-width: 130px;\">Teléfono</th>\n                    <th style=\"padding: 12px; text-align: center; border: 1px solid #ddd; white-space: nowrap;\">Acciones</th>\n                </tr>\n            </thead>\n            <tbody id=\"personasTableBody\">\n                <tr style=\"background-color: #f5f5f5;\">\n                    <td colspan=\"5\" style=\"padding: 30px; text-align: center; color: #999;\">No hay personas registradas</td>\n                </tr>\n            </tbody>\n        </table>\n    </div>\n    \n    <div style=\"display: flex; gap: 10px;\">\n        <button style=\"padding: 10px 20px; background-color: #2196F3; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 13px; flex: 1;\" onclick=\"location.reload()\">🔄 Actualizar</button>\n        <button style=\"padding: 10px 20px; background-color: #FF9800; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 13px; flex: 1;\" onclick=\"alert('Exportando a CSV...')\">📥 Exportar</button>\n    </div>\n</div>\n\n<style>\n    table tbody tr:hover {\n        background-color: #e3f2fd;\n    }\n    \n    table tbody tr:nth-child(odd) {\n        background-color: #ffffff;\n    }\n    \n    table tbody tr:nth-child(even) {\n        background-color: #f9f9f9;\n    }\n    \n    .btn-small {\n        padding: 5px 10px;\n        margin: 0 3px;\n        border: none;\n        border-radius: 3px;\n        cursor: pointer;\n        font-size: 11px;\n        color: white;\n    }\n    \n    .btn-edit { background-color: #2196F3; }\n    .btn-delete { background-color: #f44336; }\n    \n    .btn-small:hover {\n        opacity: 0.8;\n    }\n</style>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": false,
