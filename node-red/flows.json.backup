    {
        "id": "data_widget",
        "type": "ui_template",
        "z": "flow_dashboard",
        "group": "data_group",
        "name": "Historial de Datos por Persona",
        "order": 1,
        "format": "<div style=\"padding: 10px; font-family: Arial, sans-serif; display: flex; flex-direction: column; height: 100%;\">\n    <h2 style=\"color: #333; margin: 0 0 10px 0;\">📊 Datos Asociados a Personas</h2>\n    \n    <div style=\"margin-bottom: 15px; display: flex; gap: 10px; align-items: center;\">\n        <label style=\"font-weight: bold; color: #333; white-space: nowrap;\">Filtrar Persona:</label>\n        <select id=\"personaFilter\" style=\"padding: 8px; flex: 1; border: 1px solid #ddd; border-radius: 5px; font-size: 13px;\">\n            <option value=\"\">-- Todas las personas --</option>\n        </select>\n        <button style=\"padding: 8px 15px; background-color: #2196F3; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 13px;\" onclick=\"document.getElementById('personaFilter').value = ''; location.reload();\">Limpiar</button>\n    </div>\n    \n    <div style=\"flex: 1; overflow-y: auto; border: 1px solid #ddd; border-radius: 5px; margin-bottom: 15px;\">\n        <table style=\"width: 100%; border-collapse: collapse; font-size: 12px;\">\n            <thead style=\"position: sticky; top: 0;\">\n                <tr style=\"background-color: #FF9800; color: white;\">\n                    <th style=\"padding: 12px; text-align: left; border: 1px solid #ddd; white-space: nowrap; min-width: 50px;\">ID</th>\n                    <th style=\"padding: 12px; text-align: left; border: 1px solid #ddd; min-width: 140px;\">Persona</th>\n                    <th style=\"padding: 12px; text-align: left; border: 1px solid #ddd; min-width: 110px;\">Tipo Dato</th>\n                    <th style=\"padding: 12px; text-align: left; border: 1px solid #ddd; min-width: 120px;\">Valor</th>\n                    <th style=\"padding: 12px; text-align: left; border: 1px solid #ddd; min-width: 160px;\">Timestamp</th>\n                    <th style=\"padding: 12px; text-align: center; border: 1px solid #ddd; white-space: nowrap;\">Acción</th>\n                </tr>\n            </thead>\n            <tbody id=\"datosTableBody\">\n                <tr style=\"background-color: #f5f5f5;\">\n                    <td colspan=\"6\" style=\"padding: 30px; text-align: center; color: #999;\">Selecciona una persona para ver sus datos</td>\n                </tr>\n            </tbody>\n        </table>\n    </div>\n    \n    <div style=\"display: flex; gap: 10px;\">\n        <button style=\"padding: 10px 20px; background-color: #2196F3; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 13px; flex: 1;\" onclick=\"location.reload()\">🔄 Actualizar</button>\n        <button style=\"padding: 10px 20px; background-color: #4CAF50; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 13px; flex: 1;\" onclick=\"alert('Descargando datos...')\">📥 Descargar</button>\n        <button style=\"padding: 10px 20px; background-color: #f44336; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 13px; flex: 1;\" onclick=\"alert('Datos seleccionados eliminados')\">🗑️ Eliminar</button>\n    </div>\n</div>\n\n<style>\n    table tbody tr:hover {\n        background-color: #fff3e0;\n    }\n    \n    table tbody tr:nth-child(odd) {\n        background-color: #ffffff;\n    }\n    \n    table tbody tr:nth-child(even) {\n        background-color: #f9f9f9;\n    }\n    \n    select {\n        box-sizing: border-box;\n    }\n</style>",
        "x": 100,
        "y": 600,
        "wires": [
            []
        ]
    },
    {
        "id": "inject_test_command",
        "type": "inject",
        "z": "flow_commands",
        "name": "Test: Send CheckStatus",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "{\"ip\":\"192.168.4.100\",\"command\":\"Check\"}",
        "payloadType": "json",
        "x": 150,
        "y": 100,
        "wires": [
            [
                "build_command_url"
            ]
        ]
    },
    {
        "id": "build_command_url",
        "type": "function",
        "z": "flow_commands",
        "name": "Build URL",
        "func": "// Construir URL con parámetros\nconst ip = msg.payload.ip || \"192.168.4.100\";\nconst cmd = msg.payload.command || \"Check\";\n\nmsg.url = `http://192.168.4.1/send?ip=${ip}&cmd=${cmd}`;\nmsg.payload = {\n    ip: ip,\n    command: cmd,\n    url: msg.url,\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 350,
        "y": 100,
        "wires": [
            [
                "send_command"
            ]
        ]
    },
    {
        "id": "send_command",
        "type": "http request",
        "z": "flow_commands",
        "name": "HTTP GET Send",
        "method": "GET",
        "ret": "txt",
        "paytoqs": "ignore",
        "url": "{{{url}}}",
        "tls": "",
        "persist": false,
        "proxy": "",
        "authType": "",
        "x": 520,
        "y": 100,
        "wires": [
            [
                "handle_response"
            ]
        ]
    },
    {
        "id": "handle_response",
        "type": "function",
        "z": "flow_commands",
        "name": "Handle Response",
        "func": "const response = {\n    status: msg.statusCode === 200 ? 'SUCCESS' : 'ERROR',\n    statusCode: msg.statusCode,\n    response: msg.payload,\n    timestamp: new Date().toISOString()\n};\n\nmsg.payload = response;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 680,
        "y": 100,
        "wires": [
            [
                "debug_response",
                "command_status_ui"
            ]
        ]
    },
