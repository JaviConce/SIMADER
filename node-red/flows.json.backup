    {
        "id": "load_all_personas",
        "type": "sqlite",
        "z": "flow_dashboard",
        "mydb": "simader_db",
        "sql": "SELECT * FROM personas ORDER BY fecha_creacion DESC",
        "sqlite": "/Users/javierdelaconcepciondorado/.node-red/db/simader.db",
        "name": "Load All Personas",
        "x": 350,
        "y": 200,
        "wires": [
            [
                "send_personas_to_ui"
            ]
        ]
    },
    {
        "id": "send_personas_to_ui",
        "type": "function",
        "z": "flow_dashboard",
        "name": "Format Personas Data",
        "func": "// Transformar datos para mostrar en tabla\nconst personas = msg.payload || [];\n\nlet html = '';\n\nif (personas.length === 0) {\n    html = '<tr style=\"background-color: #f5f5f5;\"><td colspan=\"5\" style=\"padding: 30px; text-align: center; color: #999;\">No hay personas registradas</td></tr>';\n} else {\n    personas.forEach((persona) => {\n        html += `<tr style=\"background-color: ${personas.indexOf(persona) % 2 == 0 ? '#ffffff' : '#f9f9f9'};\">\n            <td style=\"padding: 10px; border: 1px solid #ddd;\">${persona.id}</td>\n            <td style=\"padding: 10px; border: 1px solid #ddd;\">${persona.nombre || 'N/A'}</td>\n            <td style=\"padding: 10px; border: 1px solid #ddd;\">${persona.email || 'N/A'}</td>\n            <td style=\"padding: 10px; border: 1px solid #ddd;\">${persona.telefono || 'N/A'}</td>\n            <td style=\"padding: 10px; text-align: center; border: 1px solid #ddd;\">\n                <button class=\"btn-small btn-edit\" onclick=\"alert('Editar persona ${persona.id}')\">✏️</button>\n                <button class=\"btn-small btn-delete\" onclick=\"alert('Eliminar persona ${persona.id}')\">🗑️</button>\n            </td>\n        </tr>`;\n    });\n}\n\nmsg.payload = {\n    html: html,\n    total: personas.length,\n    personas: personas\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 550,
        "y": 200,
        "wires": [
            [\n                "update_personas_table"\n            ]\n        ]
    },
    {
        "id": "update_personas_table",
        "type": "ui_template",
        "z": "flow_dashboard",
        "group": "persons_group",
        "name": "Personas Table Updater",
        "order": 2,
        "format": "<script>\nif(msg.payload && msg.payload.html) {\n    const tbody = document.getElementById('personasTableBody');\n    if(tbody) {\n        tbody.innerHTML = msg.payload.html;\n        document.getElementById('totalPersonas').textContent = msg.payload.total;\n    }\n}\n</script>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": false,
        "templateScope": "local",
        "className": "",
        "x": 750,
        "y": 200,
        "wires": [
            []\n        ]
    },
    {
        "id": "add_persona_handler",
        "type": "http in",
        "z": "flow_dashboard",
        "name": "POST /api/persona",
        "url": "/api/persona",
        "method": "post",
        "upload": false,
        "swaggerDoc": "",
        "x": 150,
        "y": 250,
        "wires": [
            [
                "validate_persona_data"
            ]
        ]
    },
    {
        "id": "validate_persona_data",
        "type": "function",
        "z": "flow_dashboard",
        "name": "Validate Data",
        "func": "// Validar datos de entrada\nconst data = msg.payload;\n\nif (!data.nombre || data.nombre.trim() === '') {\n    msg.statusCode = 400;\n    msg.payload = { error: 'El nombre es requerido' };\n    return msg;\n}\n\nif (data.email && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(data.email)) {\n    msg.statusCode = 400;\n    msg.payload = { error: 'Email inválido' };\n    return msg;\n}\n\nmsg.nombre = data.nombre.trim();\nmsg.email = data.email?.trim() || null;\nmsg.telefono = data.telefono?.trim() || null;\nmsg.descripcion = data.descripcion?.trim() || null;\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 350,
        "y": 250,
        "wires": [
            [\n                "insert_persona_db"\n            ]\n        ]
    },
    {
        "id": "insert_persona_db",
        "type": "sqlite",
        "z": "flow_dashboard",
        "mydb": "simader_db",
        "sql": "INSERT INTO personas (nombre, email, telefono, descripcion) VALUES ($nombre, $email, $telefono, $descripcion)",
        "sqlite": "/Users/javierdelaconcepciondorado/.node-red/db/simader.db",
        "name": "Insert Persona",
        "x": 550,
        "y": 250,
        "wires": [
            [\n                "persona_inserted_response"\n            ]\n        ]
    },
    {
        "id": "persona_inserted_response",
        "type": "function",
        "z": "flow_dashboard",
        "name": "Send Response",
        "func": "msg.statusCode = 200;\nmsg.payload = {\n    success: true,\n    message: 'Persona agregada exitosamente',\n    id: msg.lastID\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 750,
        "y": 250,
        "wires": [
            [\n                "http_response_persona"\n            ]\n        ]
    },
