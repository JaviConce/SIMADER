        "format": "<div style=\"padding: 15px; font-family: Arial, sans-serif;\">\n    <h3>⚙️ Estado del Comando</h3>\n    <div style=\"padding: 10px; border-radius: 5px;\" ng-class=\"{'background-color': msg.payload.status === 'SUCCESS' ? '#c8e6c9' : '#ffcdd2'};\">\n        <p style=\"margin: 5px 0;\"><strong>Estado:</strong> \n            <span style=\"color: {{msg.payload.status === 'SUCCESS' ? '#2e7d32' : '#c62828'}};\">{{msg.payload.status}}</span>\n        </p>\n        <p style=\"margin: 5px 0;\"><strong>Código HTTP:</strong> {{msg.payload.statusCode}}</p>\n        <p style=\"margin: 5px 0;\"><strong>Respuesta:</strong> {{msg.payload.response}}</p>\n        <p style=\"margin: 5px 0; font-size: 11px; color: #999;\">{{msg.payload.timestamp}}</p>\n    </div>\n</div>",
        "x": 850,
        "y": 100,
        "wires": [
            []
        ]
    },
