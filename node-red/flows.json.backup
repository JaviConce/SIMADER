    {
        "id": "mqtt_in_all",
        "type": "mqtt in",
        "z": "flow_receiver",
        "name": "Subscribe to esp32/#",
        "topic": "esp32/#",
        "qos": "2",
        "datatype": "auto",
        "broker": "mqtt_broker_main",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 200,
        "y": 100,
        "wires": [
            [
                "parse_mqtt",
                "debug_raw"
            ]
        ]
    },
    {
        "id": "debug_raw",
        "type": "debug",
        "z": "flow_receiver",
        "name": "Raw MQTT",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 500,
        "y": 60,
        "wires": []
    },
    {
        "id": "parse_mqtt",
        "type": "function",
        "z": "flow_receiver",
        "name": "Parse & Store",
        "func": "// Intentar parsear JSON si lo es\nlet payload = msg.payload;\nif(typeof payload === 'string') {\n    try {\n        payload = JSON.parse(payload);\n    } catch(e) {\n        // Si no es JSON, mantener como string\n    }\n}\n\nconst msgData = {\n    topic: msg.topic,\n    payload: payload,\n    timestamp: new Date().toISOString(),\n    date: new Date(),\n    receivedAt: Date.now()\n};\n\n// Guardar en contexto global\ncontext.set('lastMessage_' + msg.topic, msgData);\n\n// Histórico (últimos 200 mensajes por tópico)\nlet history = context.get('history_' + msg.topic) || [];\nhistory.push(msgData);\nif(history.length > 200) {\n    history = history.slice(-200);\n}\ncontext.set('history_' + msg.topic, history);\n\nmsg.payload = msgData;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 350,
        "y": 120,
        "wires": [
            [
                "store_to_db",
                "to_dashboard"
            ]
        ]
    },
    {
        "id": "to_dashboard",
        "type": "link out",
        "z": "flow_receiver",
        "name": "To Dashboard",
        "links": [
            "from_receiver"
        ],
        "x": 500,
        "y": 120,
        "wires": []
    },
    {
        "id": "store_to_db",
        "type": "link out",
        "z": "flow_receiver",
        "name": "To Storage",
        "links": [
            "from_receiver_db"
        ],
        "x": 500,
        "y": 160,
        "wires": []
    },
    {
        "id": "from_receiver",
        "type": "link in",
        "z": "flow_dashboard",
        "name": "From Receiver",
        "links": [
            "to_dashboard"
        ],
        "x": 50,
        "y": 320,
        "wires": [
            [
                "update_dashboard"
            ]
        ]
    },
    {
        "id": "poll_clients",
        "type": "inject",
        "z": "flow_dashboard",
        "name": "Poll Every 5s",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "5",
        "crontab": "",
        "once": true,
        "onceDelay": "0.5",
        "topic": "",
        "payload": "{}",
        "payloadType": "json",
        "x": 150,
        "y": 100,
        "wires": [
            [
                "get_clients_http"
            ]
        ]
    },
    {
        "id": "get_clients_http",
        "type": "http request",
        "z": "flow_dashboard",
        "name": "GET /api/clients",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://192.168.4.1:80/api/clients",
        "tls": "",
        "persist": false,
        "proxy": "",
        "authType": "",
        "x": 330,
        "y": 100,
        "wires": [
            [
                "process_clients_data"
            ]
        ]
    },
    {
        "id": "process_clients_data",
        "type": "function",
        "z": "flow_dashboard",
        "name": "Process Clients",
        "func": "// Procesar respuesta del ESP32\nlet clients = [];\n\nif(msg.payload && msg.payload.clients) {\n    // Transformar formato del ESP32 al formato esperado\n    clients = msg.payload.clients.map(c => ({\n        clientId: c.id || 'unknown',\n        ip: c.ip || 'unknown',\n        connectedTime: c.uptime || 0,\n        connected: c.connected !== false\n    }));\n} else if(Array.isArray(msg.payload)) {\n    clients = msg.payload;\n}\n\ncontext.set('connectedClients', clients);\n\nmsg.payload = {\n    totalClients: clients.length,\n    clients: clients,\n    timestamp: new Date().toISOString(),\n    lastUpdate: new Date()\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 520,
        "y": 100,
        "wires": [
            [
                "display_clients_text",
                "debug_clients"
            ]
        ]
    },
    {
        "id": "debug_clients",
        "type": "debug",
        "z": "flow_dashboard",
        "name": "Clients Debug",
        "active": false,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 700,
        "y": 60,
        "wires": []
    },
    {
        "id": "display_clients_text",
        "type": "ui_template",
        "z": "flow_dashboard",
        "group": "clients_group",
        "name": "Connected Clients",
        "order": 1,
        "format": "<div style=\"padding: 15px; font-family: Arial, sans-serif;\">\n    <h3 style=\"margin-top: 0; color: #333;\">🔌 Dispositivos Conectados</h3>\n    <div style=\"background: #f0f0f0; padding: 10px; border-radius: 5px; margin-bottom: 15px;\">\n        <p style=\"margin: 5px 0; font-size: 18px; font-weight: bold; color: #2196F3;\">\n            Total: <span style=\"color: #00AA00;\">{{msg.payload.totalClients}}</span>\n        </p>\n        <p style=\"margin: 5px 0; font-size: 12px; color: #666;\">\n            Última actualización: {{msg.payload.lastUpdate | date:'HH:mm:ss'}}\n        </p>\n    </div>\n    \n    <div ng-if=\"msg.payload.totalClients === 0\" style=\"text-align: center; color: #999; padding: 20px;\">\n        <p>No hay dispositivos conectados</p>\n    </div>\n    \n    <table ng-if=\"msg.payload.totalClients > 0\" style=\"width:100%; border-collapse: collapse; font-size: 12px;\">\n        <tr style=\"background-color: #2196F3; color: white;\">\n            <th style=\"padding: 10px; text-align: left; border: 1px solid #ddd;\">Client ID</th>\n            <th style=\"padding: 10px; text-align: left; border: 1px solid #ddd;\">IP Address</th>\n            <th style=\"padding: 10px; text-align: left; border: 1px solid #ddd;\">Tiempo (s)</th>\n        </tr>\n        <tr ng-repeat=\"client in msg.payload.clients\" style=\"background-color: {{$index % 2 == 0 ? '#ffffff' : '#f9f9f9'}}; border-bottom: 1px solid #ddd;\">\n            <td style=\"padding: 10px; border: 1px solid #ddd;\">{{client.clientId}}</td>\n            <td style=\"padding: 10px; border: 1px solid #ddd;\">{{client.ip}}</td>\n            <td style=\"padding: 10px; border: 1px solid #ddd;\">{{client.connectedTime}}</td>\n        </tr>\n    </table>\n</div>",
        "x": 700,
        "y": 100,
        "wires": [
            []
        ]
    },
    {
        "id": "update_dashboard",
        "type": "ui_template",
        "z": "flow_dashboard",
        "group": "status_group",
        "name": "Live Data",
        "order": 2,
        "format": "<div style=\"padding: 15px; font-family: Arial, sans-serif;\">\n    <h3 style=\"margin-top: 0; color: #333;\">📊 Últimos Datos Recibidos</h3>\n    <div style=\"background: #f5f5f5; padding: 10px; border-radius: 5px; border-left: 4px solid #FF9800;\">\n        <p style=\"margin: 5px 0;\"><strong>Tópico:</strong> {{msg.payload.topic}}</p>\n        <p style=\"margin: 5px 0;\"><strong>Payload:</strong> <code>{{msg.payload.payload | json}}</code></p>\n        <p style=\"margin: 5px 0;\"><strong>Timestamp:</strong> {{msg.payload.timestamp}}</p>\n    </div>\n</div>",
        "x": 250,
        "y": 320,
        "wires": [
            []
        ]
    },
    {
        "id": "capture_widget",
        "type": "ui_template",
        "z": "flow_dashboard",
        "group": "capture_group",
        "name": "Control de Captura",
        "order": 1,
        "format": "<div style=\"padding: 20px; font-family: Arial, sans-serif;\">\n    <h2 style=\"color: #333;\">📸 Captura de Datos</h2>\n    <p style=\"color: #666;\">Aquí puedes capturar y grabar datos en tiempo real de los dispositivos ESP32</p>\n    \n    <div style=\"margin-top: 20px;\">\n        <button style=\"padding: 10px 20px; background-color: #4CAF50; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 14px;\" onclick=\"alert('Función de captura habilitada')\">▶️ Iniciar Captura</button>\n        <button style=\"padding: 10px 20px; background-color: #f44336; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 14px; margin-left: 10px;\" onclick=\"alert('Captura detenida')\">⏹️ Detener Captura</button>\n    </div>\n    \n    <div style=\"margin-top: 20px; padding: 15px; background-color: #f5f5f5; border-radius: 5px;\">\n        <h3 style=\"color: #333;\">Estado de Captura</h3>\n        <p><strong>Estado:</strong> <span style=\"color: #2196F3;\">Listo</span></p>\n        <p><strong>Dispositivos monitoreados:</strong> <span style=\"color: #2196F3;\">0</span></p>\n        <p><strong>Registros capturados:</strong> <span style=\"color: #2196F3;\">0</span></p>\n    </div>\n</div>",
        "x": 100,
        "y": 400,
        "wires": [
            []
        ]
    },
    {
        "id": "history_widget",
        "type": "ui_template",
        "z": "flow_dashboard",
        "group": "history_group",
        "name": "Registro Histórico",
        "order": 1,
        "format": "<div style=\"padding: 20px; font-family: Arial, sans-serif;\">\n    <h2 style=\"color: #333;\">📊 Registrar Datos Históricos</h2>\n    <p style=\"color: #666;\">Visualiza y analiza el historial de datos capturados</p>\n    \n    <div style=\"margin-top: 20px;\">\n        <button style=\"padding: 10px 20px; background-color: #2196F3; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 14px;\" onclick=\"alert('Exportando datos...')\">📥 Exportar CSV</button>\n        <button style=\"padding: 10px 20px; background-color: #FF9800; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 14px; margin-left: 10px;\" onclick=\"alert('Datos descargados')\">💾 Descargar JSON</button>\n        <button style=\"padding: 10px 20px; background-color: #f44336; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 14px; margin-left: 10px;\" onclick=\"alert('Datos eliminados')\">🗑️ Limpiar Historial</button>\n    </div>\n    \n    <div style=\"margin-top: 20px; padding: 15px; background-color: #f5f5f5; border-radius: 5px;\">\n        <h3 style=\"color: #333;\">Información del Historial</h3>\n        <table style=\"width: 100%; border-collapse: collapse;\">\n            <tr style=\"background-color: #e0e0e0;\">\n                <th style=\"padding: 10px; text-align: left; border: 1px solid #ddd;\">Parámetro</th>\n                <th style=\"padding: 10px; text-align: left; border: 1px solid #ddd;\">Valor</th>\n            </tr>\n            <tr>\n                <td style=\"padding: 10px; border: 1px solid #ddd;\"><strong>Total de registros</strong></td>\n                <td style=\"padding: 10px; border: 1px solid #ddd;\"><span style=\"color: #2196F3;\">0</span></td>\n            </tr>\n            <tr style=\"background-color: #f9f9f9;\">\n                <td style=\"padding: 10px; border: 1px solid #ddd;\"><strong>Período cubierto</strong></td>\n                <td style=\"padding: 10px; border: 1px solid #ddd;\"><span style=\"color: #2196F3;\">N/A</span></td>\n            </tr>\n            <tr>\n                <td style=\"padding: 10px; border: 1px solid #ddd;\"><strong>Último registro</strong></td>\n                <td style=\"padding: 10px; border: 1px solid #ddd;\"><span style=\"color: #2196F3;\">N/A</span></td>\n            </tr>\n        </table>\n    </div>\n</div>",
        "x": 100,
        "y": 450,
        "wires": [
            []
        ]
    },
    {
        "id": "config_widget",
        "type": "ui_template",
        "z": "flow_dashboard",
        "group": "config_group",
        "name": "Agregar Persona",
        "order": 1,
        "width": "",
        "height": "",
        "format": "<div style=\"padding: 20px; font-family: Arial, sans-serif;\">\n    <h2 style=\"color: #333;\">👥 Agregar Nueva Persona</h2>\n    <p style=\"color: #666;\">Registra una nueva persona en la base de datos</p>\n    \n    <div style=\"margin-top: 20px; padding: 20px; background-color: #f5f5f5; border-radius: 5px;\">\n        <div style=\"margin-bottom: 15px;\">\n            <label style=\"display: block; margin-bottom: 5px; font-weight: bold; color: #333;\">Nombre Completo:</label>\n            <input type=\"text\" id=\"nombre\" placeholder=\"Ej: Juan Pérez\" style=\"width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px; box-sizing: border-box;\">\n        </div>\n        \n        <div style=\"margin-bottom: 15px;\">\n            <label style=\"display: block; margin-bottom: 5px; font-weight: bold; color: #333;\">Email:</label>\n            <input type=\"email\" id=\"email\" placeholder=\"Ej: juan@example.com\" style=\"width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px; box-sizing: border-box;\">\n        </div>\n        \n        <div style=\"margin-bottom: 15px;\">\n            <label style=\"display: block; margin-bottom: 5px; font-weight: bold; color: #333;\">Teléfono:</label>\n            <input type=\"tel\" id=\"telefono\" placeholder=\"Ej: +34 612345678\" style=\"width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px; box-sizing: border-box;\">\n        </div>\n        \n        <div style=\"margin-bottom: 15px;\">\n            <label style=\"display: block; margin-bottom: 5px; font-weight: bold; color: #333;\">Descripción:</label>\n            <textarea id=\"descripcion\" placeholder=\"Descripción opcional\" style=\"width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px; box-sizing: border-box; height: 80px; resize: vertical;\"></textarea>\n        </div>\n        \n        <button style=\"padding: 12px 24px; background-color: #4CAF50; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 14px; font-weight: bold; width: 100%;\" onclick=\"guardarPersona()\">➕ Agregar Persona</button>\n        <div id=\"mensaje\" style=\"margin-top: 10px; padding: 10px; border-radius: 5px; display: none;\"></div>\n    </div>\n</div>\n\n<script>\nfunction guardarPersona() {\n    const nombre = document.getElementById('nombre').value;\n    const email = document.getElementById('email').value;\n    const telefono = document.getElementById('telefono').value;\n    const descripcion = document.getElementById('descripcion').value;\n    const mensajeDiv = document.getElementById('mensaje');\n    \n    if (!nombre.trim()) {\n        mensajeDiv.style.backgroundColor = '#ffcdd2';\n        mensajeDiv.style.color = '#c62828';\n        mensajeDiv.textContent = '❌ El nombre es requerido';\n        mensajeDiv.style.display = 'block';\n        return;\n    }\n    \n    const datos = {\n        nombre: nombre.trim(),\n        email: email.trim() || null,\n        telefono: telefono.trim() || null,\n        descripcion: descripcion.trim() || null\n    };\n    \n    fetch('/api/persona', {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify(datos)\n    })\n    .then(r => r.json())\n    .then(data => {\n        if (data.success) {\n            mensajeDiv.style.backgroundColor = '#c8e6c9';\n            mensajeDiv.style.color = '#2e7d32';\n            mensajeDiv.textContent = '✅ ' + data.message;\n            document.getElementById('nombre').value = '';\n            document.getElementById('email').value = '';\n            document.getElementById('telefono').value = '';\n            document.getElementById('descripcion').value = '';\n            setTimeout(() => { location.reload(); }, 1500);\n        } else {\n            mensajeDiv.style.backgroundColor = '#ffcdd2';\n            mensajeDiv.style.color = '#c62828';\n            mensajeDiv.textContent = '❌ ' + (data.error || 'Error al guardar');\n        }\n        mensajeDiv.style.display = 'block';\n    })\n    .catch(e => {\n        mensajeDiv.style.backgroundColor = '#ffcdd2';\n        mensajeDiv.style.color = '#c62828';\n        mensajeDiv.textContent = '❌ Error: ' + e.message;\n        mensajeDiv.style.display = 'block';\n    });\n}\n</script>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": false,
        "templateScope": "local",
        "className": "",
        "x": 100,
        "y": 500,
        "wires": [
