        "func": "// Preparar datos para BD\nconst record = {\n    topic: msg.payload.topic,\n    payload: JSON.stringify(msg.payload.payload),\n    timestamp: msg.payload.timestamp,\n    received_at: msg.payload.receivedAt\n};\n\nmsg.payload = record;\nreturn msg;",
