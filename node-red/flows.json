        "func": "const ip = msg.payload.ip || \"192.168.4.100\";\nconst cmd = msg.payload.command || \"Check\";\n\nmsg.url = `http://192.168.4.1/send?ip=${ip}&cmd=${cmd}`;\nmsg.payload = {\n    ip: ip,\n    command: cmd,\n    url: msg.url,\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;",
