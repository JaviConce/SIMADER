            []
        ]
    },
    {
        "id": "capture_widget",
        "type": "ui_template",
        "z": "flow_dashboard",
        "group": "capture_group",
        "name": "Control de Captura",
        "order": 1,
        "format": "<div style=\"padding: 20px; font-family: Arial, sans-serif;\">\n    <h2 style=\"color: #333;\">📸 Captura de Datos</h2>\n    <p style=\"color: #666;\">Aquí puedes capturar y grabar datos en tiempo real de los dispositivos ESP32</p>\n    \n    <div style=\"margin-top: 20px;\">\n        <button style=\"padding: 10px 20px; background-color: #4CAF50; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 14px;\" onclick=\"alert('Función de captura habilitada')\">▶️ Iniciar Captura</button>\n        <button style=\"padding: 10px 20px; background-color: #f44336; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 14px; margin-left: 10px;\" onclick=\"alert('Captura detenida')\">⏹️ Detener Captura</button>\n    </div>\n    \n    <div style=\"margin-top: 20px; padding: 15px; background-color: #f5f5f5; border-radius: 5px;\">\n        <h3 style=\"color: #333;\">Estado de Captura</h3>\n        <p><strong>Estado:</strong> <span style=\"color: #2196F3;\">Listo</span></p>\n        <p><strong>Dispositivos monitoreados:</strong> <span style=\"color: #2196F3;\">0</span></p>\n        <p><strong>Registros capturados:</strong> <span style=\"color: #2196F3;\">0</span></p>\n    </div>\n</div>",
        "x": 100,
        "y": 400,
        "wires": [
            []
        ]
    },
    {
        "id": "history_widget",
        "type": "ui_template",
        "z": "flow_dashboard",
        "group": "history_group",
        "name": "Registro Histórico",
        "order": 1,
        "format": "<div style=\"padding: 20px; font-family: Arial, sans-serif;\">\n    <h2 style=\"color: #333;\">📊 Registrar Datos Históricos</h2>\n    <p style=\"color: #666;\">Visualiza y analiza el historial de datos capturados</p>\n    \n    <div style=\"margin-top: 20px;\">\n        <button style=\"padding: 10px 20px; background-color: #2196F3; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 14px;\" onclick=\"alert('Exportando datos...')\">📥 Exportar CSV</button>\n        <button style=\"padding: 10px 20px; background-color: #FF9800; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 14px; margin-left: 10px;\" onclick=\"alert('Datos descargados')\">💾 Descargar JSON</button>\n        <button style=\"padding: 10px 20px; background-color: #f44336; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 14px; margin-left: 10px;\" onclick=\"alert('Datos eliminados')\">🗑️ Limpiar Historial</button>\n    </div>\n    \n    <div style=\"margin-top: 20px; padding: 15px; background-color: #f5f5f5; border-radius: 5px;\">\n        <h3 style=\"color: #333;\">Información del Historial</h3>\n        <table style=\"width: 100%; border-collapse: collapse;\">\n            <tr style=\"background-color: #e0e0e0;\">\n                <th style=\"padding: 10px; text-align: left; border: 1px solid #ddd;\">Parámetro</th>\n                <th style=\"padding: 10px; text-align: left; border: 1px solid #ddd;\">Valor</th>\n            </tr>\n            <tr>\n                <td style=\"padding: 10px; border: 1px solid #ddd;\"><strong>Total de registros</strong></td>\n                <td style=\"padding: 10px; border: 1px solid #ddd;\"><span style=\"color: #2196F3;\">0</span></td>\n            </tr>\n            <tr style=\"background-color: #f9f9f9;\">\n                <td style=\"padding: 10px; border: 1px solid #ddd;\"><strong>Período cubierto</strong></td>\n                <td style=\"padding: 10px; border: 1px solid #ddd;\"><span style=\"color: #2196F3;\">N/A</span></td>\n            </tr>\n            <tr>\n                <td style=\"padding: 10px; border: 1px solid #ddd;\"><strong>Último registro</strong></td>\n                <td style=\"padding: 10px; border: 1px solid #ddd;\"><span style=\"color: #2196F3;\">N/A</span></td>\n            </tr>\n        </table>\n    </div>\n</div>",
        "x": 100,
        "y": 450,
        "wires": [
            []
        ]
    },
    {
        "id": "config_widget",
        "type": "ui_template",
        "z": "flow_dashboard",
        "group": "config_group",
        "name": "Agregar Persona",
        "order": 1,
        "format": "<div style=\"padding: 20px; font-family: Arial, sans-serif;\">\n    <h2 style=\"color: #333;\">👥 Agregar Nueva Persona</h2>\n    <p style=\"color: #666;\">Registra una nueva persona (próximamente en base de datos)</p>\n    \n    <div style=\"margin-top: 20px; padding: 20px; background-color: #f5f5f5; border-radius: 5px;\">\n        <div style=\"margin-bottom: 15px;\">\n            <label style=\"display: block; margin-bottom: 5px; font-weight: bold; color: #333;\">Nombre Completo:</label>\n            <input type=\"text\" id=\"nombre\" placeholder=\"Ej: Juan Pérez\" style=\"width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px; box-sizing: border-box;\">\n        </div>\n        \n        <div style=\"margin-bottom: 15px;\">\n            <label style=\"display: block; margin-bottom: 5px; font-weight: bold; color: #333;\">Email:</label>\n            <input type=\"email\" id=\"email\" placeholder=\"Ej: juan@example.com\" style=\"width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px; box-sizing: border-box;\">\n        </div>\n        \n        <div style=\"margin-bottom: 15px;\">\n            <label style=\"display: block; margin-bottom: 5px; font-weight: bold; color: #333;\">Teléfono:</label>\n            <input type=\"tel\" id=\"telefono\" placeholder=\"Ej: +34 612345678\" style=\"width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px; box-sizing: border-box;\">\n        </div>\n        \n        <div style=\"margin-bottom: 15px;\">\n            <label style=\"display: block; margin-bottom: 5px; font-weight: bold; color: #333;\">Descripción:</label>\n            <textarea id=\"descripcion\" placeholder=\"Descripción opcional\" style=\"width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px; box-sizing: border-box; height: 80px; resize: vertical;\"></textarea>\n        </div>\n        \n        <button style=\"padding: 12px 24px; background-color: #4CAF50; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 14px; font-weight: bold; width: 100%;\" onclick=\"guardarPersona()\">➕ Agregar Persona</button>\n        <div id=\"mensaje\" style=\"margin-top: 10px; padding: 10px; border-radius: 5px; display: none;\"></div>\n    </div>\n</div>\n\n<script>\nfunction guardarPersona() {\n    const nombre = document.getElementById('nombre').value;\n    const email = document.getElementById('email').value;\n    const telefono = document.getElementById('telefono').value;\n    const descripcion = document.getElementById('descripcion').value;\n    const mensajeDiv = document.getElementById('mensaje');\n    \n    if (!nombre.trim()) {\n        mensajeDiv.style.backgroundColor = '#ffcdd2';\n        mensajeDiv.style.color = '#c62828';\n        mensajeDiv.textContent = '❌ El nombre es requerido';\n        mensajeDiv.style.display = 'block';\n        return;\n    }\n    \n    const datos = {\n        nombre: nombre.trim(),\n        email: email.trim() || null,\n        telefono: telefono.trim() || null,\n        descripcion: descripcion.trim() || null\n    };\n    \n    // Guardar en localStorage por ahora\n    let personas = JSON.parse(localStorage.getItem('personas')) || [];\n    datos.id = Math.max(...personas.map(p => p.id || 0), 0) + 1;\n    datos.fecha_creacion = new Date().toISOString();\n    personas.push(datos);\n    localStorage.setItem('personas', JSON.stringify(personas));\n    \n    mensajeDiv.style.backgroundColor = '#c8e6c9';\n    mensajeDiv.style.color = '#2e7d32';\n    mensajeDiv.textContent = '✅ Persona agregada exitosamente';\n    document.getElementById('nombre').value = '';\n    document.getElementById('email').value = '';\n    document.getElementById('telefono').value = '';\n    document.getElementById('descripcion').value = '';\n    \n    mensajeDiv.style.display = 'block';\n    setTimeout(() => { location.reload(); }, 1500);\n}\n</script>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": false,
        "templateScope": "local",
        "className": "",
        "x": 100,
        "y": 500,
        "wires": [
            []
        ]
