                "parse_mqtt",
                "debug_raw"
            ]
        ]
    },
    {
        "id": "debug_raw",
        "type": "debug",
        "z": "flow_receiver",
        "name": "Raw MQTT",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 500,
        "y": 60,
        "wires": []
    },
    {
        "id": "parse_mqtt",
        "type": "function",
        "z": "flow_receiver",
        "name": "Parse & Store",
        "func": "let payload = msg.payload;\nif(typeof payload === 'string') {\n    try {\n        payload = JSON.parse(payload);\n    } catch(e) {}\n}\n\nconst msgData = {\n    topic: msg.topic,\n    payload: payload,\n    timestamp: new Date().toISOString(),\n    date: new Date(),\n    receivedAt: Date.now()\n};\n\ncontext.set('lastMessage_' + msg.topic, msgData);\n\nlet history = context.get('history_' + msg.topic) || [];\nhistory.push(msgData);\nif(history.length > 200) {\n    history = history.slice(-200);\n}\ncontext.set('history_' + msg.topic, history);\n\nmsg.payload = msgData;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 500,
        "y": 120,
        "wires": [
            [
                "to_dashboard"
            ]
        ]
    },
    {
        "id": "to_dashboard",
        "type": "link out",
        "z": "flow_receiver",
        "name": "To Dashboard",
        "links": [
            "from_receiver"
        ],
        "x": 500,
        "y": 120,
        "wires": []
    },
    {
        "id": "from_receiver",
        "type": "link in",
        "z": "flow_dashboard",
        "name": "From Receiver",
        "links": [
            "to_dashboard"
        ],
        "x": 50,
        "y": 320,
        "wires": [
            [
                "update_dashboard"
            ]
        ]
    },
    {
        "id": "poll_clients",
        "type": "inject",
        "z": "flow_dashboard",
        "name": "Poll Every 5s",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "5",
        "crontab": "",
        "once": true,
        "onceDelay": "0.5",
        "topic": "",
        "payload": "{}",
        "payloadType": "json",
        "x": 150,
        "y": 100,
        "wires": [
            [
                "get_clients_http"
            ]
        ]
    },
    {
        "id": "get_clients_http",
        "type": "http request",
        "z": "flow_dashboard",
        "name": "GET /api/clients",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://192.168.4.1:80/api/clients",
        "tls": "",
        "persist": false,
        "proxy": "",
        "authType": "",
        "x": 330,
        "y": 100,
        "wires": [
            [
                "process_clients_data"
            ]
        ]
    },
    {
        "id": "process_clients_data",
        "type": "function",
        "z": "flow_dashboard",
        "name": "Process Clients",
        "func": "let clients = [];\n\nif(msg.payload && msg.payload.clients) {\n    clients = msg.payload.clients.map(c => ({\n        clientId: c.id || 'unknown',\n        ip: c.ip || 'unknown',\n        connectedTime: c.uptime || 0,\n        connected: c.connected !== false\n    }));\n} else if(Array.isArray(msg.payload)) {\n    clients = msg.payload;\n}\n\ncontext.set('connectedClients', clients);\n\nmsg.payload = {\n    totalClients: clients.length,\n    clients: clients,\n    timestamp: new Date().toISOString(),\n    lastUpdate: new Date()\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 520,
        "y": 100,
        "wires": [
            [
                "display_clients_text",
                "debug_clients"
            ]
        ]
    },
    {
        "id": "debug_clients",
        "type": "debug",
        "z": "flow_dashboard",
        "name": "Clients Debug",
        "active": false,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 700,
        "y": 60,
        "wires": []
    },
    {
        "id": "display_clients_text",
        "type": "ui_template",
        "z": "flow_dashboard",
        "group": "clients_group",
        "name": "Connected Clients",
        "order": 1,
        "format": "<div style=\"padding: 15px; font-family: Arial, sans-serif;\">\n    <h3 style=\"margin-top: 0; color: #333;\">🔌 Dispositivos Conectados</h3>\n    <div style=\"background: #f0f0f0; padding: 10px; border-radius: 5px; margin-bottom: 15px;\">\n        <p style=\"margin: 5px 0; font-size: 18px; font-weight: bold; color: #2196F3;\">\n            Total: <span style=\"color: #00AA00;\">{{msg.payload.totalClients}}</span>\n        </p>\n        <p style=\"margin: 5px 0; font-size: 12px; color: #666;\">\n            Última actualización: {{msg.payload.lastUpdate | date:'HH:mm:ss'}}\n        </p>\n    </div>\n    \n    <div ng-if=\"msg.payload.totalClients === 0\" style=\"text-align: center; color: #999; padding: 20px;\">\n        <p>No hay dispositivos conectados</p>\n    </div>\n    \n    <table ng-if=\"msg.payload.totalClients > 0\" style=\"width:100%; border-collapse: collapse; font-size: 12px;\">\n        <tr style=\"background-color: #2196F3; color: white;\">\n            <th style=\"padding: 10px; text-align: left; border: 1px solid #ddd;\">Client ID</th>\n            <th style=\"padding: 10px; text-align: left; border: 1px solid #ddd;\">IP Address</th>\n            <th style=\"padding: 10px; text-align: left; border: 1px solid #ddd;\">Tiempo (s)</th>\n        </tr>\n        <tr ng-repeat=\"client in msg.payload.clients\" style=\"background-color: {{$index % 2 == 0 ? '#ffffff' : '#f9f9f9'}}; border-bottom: 1px solid #ddd;\">\n            <td style=\"padding: 10px; border: 1px solid #ddd;\">{{client.clientId}}</td>\n            <td style=\"padding: 10px; border: 1px solid #ddd;\">{{client.ip}}</td>\n            <td style=\"padding: 10px; border: 1px solid #ddd;\">{{client.connectedTime}}</td>\n        </tr>\n    </table>\n</div>",
        "x": 710,
        "y": 140,
        "wires": [
            []
        ]
    },
    {
        "id": "update_dashboard",
        "type": "ui_template",
        "z": "flow_dashboard",
        "group": "status_group",
        "name": "Live Data",
        "order": 2,
        "format": "<div style=\"padding: 15px; font-family: Arial, sans-serif;\">\n    <h3 style=\"margin-top: 0; color: #333;\">📊 Últimos Datos Recibidos</h3>\n    <div style=\"background: #f5f5f5; padding: 10px; border-radius: 5px; border-left: 4px solid #FF9800;\">\n        <p style=\"margin: 5px 0;\"><strong>Tópico:</strong> {{msg.payload.topic}}</p>\n        <p style=\"margin: 5px 0;\"><strong>Payload:</strong> <code>{{msg.payload.payload | json}}</code></p>\n        <p style=\"margin: 5px 0;\"><strong>Timestamp:</strong> {{msg.payload.timestamp}}</p>\n    </div>\n</div>",
        "x": 250,
