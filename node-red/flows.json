        "name": "Tabla de Personas",
        "order": 1,
        "format": "<div style=\"padding: 10px; font-family: Arial, sans-serif; display: flex; flex-direction: column; height: 100%;\">\n    <h2 style=\"color: #333; margin: 0 0 10px 0;\">📋 Personas Registradas</h2>\n    <p style=\"color: #666; margin: 0 0 15px 0;\">Total: <span style=\"color: #2196F3; font-weight: bold;\" id=\"totalPersonas\">0</span> personas</p>\n    \n    <div style=\"flex: 1; overflow-y: auto; border: 1px solid #ddd; border-radius: 5px; margin-bottom: 15px;\">\n        <table style=\"width: 100%; border-collapse: collapse; font-size: 13px;\">\n            <thead style=\"position: sticky; top: 0;\">\n                <tr style=\"background-color: #2196F3; color: white;\">\n                    <th style=\"padding: 12px; text-align: left; border: 1px solid #ddd; white-space: nowrap;\">ID</th>\n                    <th style=\"padding: 12px; text-align: left; border: 1px solid #ddd; min-width: 150px;\">Nombre</th>\n                    <th style=\"padding: 12px; text-align: left; border: 1px solid #ddd; min-width: 180px;\">Email</th>\n                    <th style=\"padding: 12px; text-align: left; border: 1px solid #ddd; min-width: 130px;\">Teléfono</th>\n                    <th style=\"padding: 12px; text-align: center; border: 1px solid #ddd; white-space: nowrap;\">Acciones</th>\n                </tr>\n            </thead>\n            <tbody id=\"personasTableBody\">\n                <tr style=\"background-color: #f5f5f5;\">\n                    <td colspan=\"5\" style=\"padding: 30px; text-align: center; color: #999;\">No hay personas registradas</td>\n                </tr>\n            </tbody>\n        </table>\n    </div>\n    \n    <div style=\"display: flex; gap: 10px;\">\n        <button style=\"padding: 10px 20px; background-color: #2196F3; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 13px; flex: 1;\" onclick=\"cargarPersonas()\">🔄 Actualizar</button>\n        <button style=\"padding: 10px 20px; background-color: #FF9800; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 13px; flex: 1;\" onclick=\"alert('Exportando a CSV...')\">📥 Exportar</button>\n    </div>\n</div>\n\n<script>\nfunction cargarPersonas() {\n    const personas = JSON.parse(localStorage.getItem('personas')) || [];\n    const tbody = document.getElementById('personasTableBody');\n    const totalEl = document.getElementById('totalPersonas');\n    \n    if (personas.length === 0) {\n        tbody.innerHTML = '<tr style=\"background-color: #f5f5f5;\"><td colspan=\"5\" style=\"padding: 30px; text-align: center; color: #999;\">No hay personas registradas</td></tr>';\n        totalEl.textContent = '0';\n        return;\n    }\n    \n    let html = '';\n    personas.forEach((persona, idx) => {\n        html += `<tr style=\"background-color: ${idx % 2 == 0 ? '#ffffff' : '#f9f9f9'};\">\n            <td style=\"padding: 10px; border: 1px solid #ddd;\">${persona.id}</td>\n            <td style=\"padding: 10px; border: 1px solid #ddd;\">${persona.nombre || 'N/A'}</td>\n            <td style=\"padding: 10px; border: 1px solid #ddd;\">${persona.email || 'N/A'}</td>\n            <td style=\"padding: 10px; border: 1px solid #ddd;\">${persona.telefono || 'N/A'}</td>\n            <td style=\"padding: 10px; text-align: center; border: 1px solid #ddd;\">\n                <button class=\"btn-small btn-delete\" onclick=\"eliminarPersona(${persona.id})\">🗑️</button>\n            </td>\n        </tr>`;\n    });\n    \n    tbody.innerHTML = html;\n    totalEl.textContent = personas.length;\n}\n\nfunction eliminarPersona(id) {\n    if (confirm('¿Estás seguro de que deseas eliminar esta persona?')) {\n        let personas = JSON.parse(localStorage.getItem('personas')) || [];\n        personas = personas.filter(p => p.id !== id);\n        localStorage.setItem('personas', JSON.stringify(personas));\n        cargarPersonas();\n    }\n}\n\nsetTimeout(cargarPersonas, 100);\n</script>\n\n<style>\n    table tbody tr:hover {\n        background-color: #e3f2fd;\n    }\n    \n    .btn-small {\n        padding: 5px 10px;\n        margin: 0 3px;\n        border: none;\n        border-radius: 3px;\n        cursor: pointer;\n        font-size: 11px;\n        color: white;\n        background-color: #f44336;\n    }\n    \n    .btn-small:hover {\n        opacity: 0.8;\n    }\n</style>",
