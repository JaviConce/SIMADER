    {
        "id": "mqtt_in_all",
        "type": "mqtt in",
        "z": "flow_receiver",
        "name": "Subscribe to esp32/#",
        "topic": "esp32/#",
        "qos": "2",
        "datatype": "auto",
        "broker": "mqtt_broker_main",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 200,
        "y": 100,
        "wires": [
